[Unit]
Description=SSRF-Lab vulnerable app (exposed to agent network)
After=network.target ssrf-lab-internal.service
Requires=ssrf-lab-internal.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ssrf-lab
# Expose the vulnerable app to the network so your agent can reach it.
# Internal fake services stay loopback-only regardless.
Environment=SSRF_LAB_HOST=0.0.0.0
Environment=SSRF_LAB_PORT=5000
ExecStart=/opt/ssrf-lab/venv/bin/python /opt/ssrf-lab/app.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
